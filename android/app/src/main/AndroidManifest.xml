<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Depolama İzinleri (CSV İçe / Dışa Aktarma - FR-09) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <!-- Ağ İzinleri (Kelime Senkronizasyonu ve Gönderen İtibar Sorgusu - FR-05) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- SMS Dinleme İzni (Çalışma Zamanı İzni - FR-02) -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- Android 13+ (API 33) Bildirim Gösterme İzni (Çalışma Zamanı İzni - FR-08) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="SMS Filtering"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:usesCleartextTraffic="true">

        <!-- Ana Ekran ve Uygulama Launcher Aktivitesi -->
        <activity
            android:name="com.smsfiltering.client.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- IP 4: Güvenlik bildiriminden mesaj detayına deep-link -->
            <intent-filter>
                <action android:name="com.smsfiltering.ACTION_OPEN_MESSAGE_DETAIL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Gelen SMS'leri Gerçek Zamanlı Yakalayan BroadcastReceiver (FR-02) -->
        <receiver
            android:name="com.smsfiltering.client.receiver.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
